{
  "name": "lazyrepo",
  "version": "0.0.0-alpha.27",
  "description": "lazyrepo is a caching task runner for npm/yarn/pnpm monorepos",
  "keywords": [],
  "license": "MIT",
  "author": "David Sheldrick",
  "repository": {
    "type": "git",
    "url": "https://github.com/ds300/lazyrepo.git"
  },
  "bin": {
    "lazy": "./bin.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin.js",
    "src",
    "assets",
    "LICENSE"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "rimraf .test && vitest run",
    "update-snapshots": "vitest run -u",
    "clean": "rm -rf node_modules && pnpm install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsgo",
    "pack-test-version": "node scripts/pack-test-version.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^2.2.0",
    "cac": "^6.7.14",
    "ci-info": "^3.8.0",
    "cross-spawn": "^7.0.3",
    "esbuild": "^0.17.15",
    "fast-json-stable-stringify": "^2.1.0",
    "micromatch": "^4.0.5",
    "picocolors": "^1.0.0",
    "slash": "^5.0.1",
    "slice-ansi": "^6.0.0",
    "source-map-support": "^0.5.21",
    "strip-ansi": "^7.0.1",
    "ts-dedent": "^2.2.0",
    "yaml": "^2.2.1",
    "zod": "^3.21.4",
    "zod-validation-error": "^1.3.0"
  },
  "devDependencies": {
    "@auto-it/core": "^10.44.0",
    "@cloudflare/workers-types": "^4.20230404.0",
    "@octokit/rest": "^19.0.7",
    "@octokit/webhooks-types": "^6.11.0",
    "@types/cross-spawn": "^6.0.2",
    "@types/micromatch": "^4.0.2",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.3.13",
    "@types/slice-ansi": "^5.0.0",
    "@types/source-map-support": "^0.5.6",
    "@typescript/native-preview": "7.0.0-dev.20260319.1",
    "auto": "^10.44.0",
    "husky": "^9.1.7",
    "immer": "^10.0.1",
    "memfs": "^3.5.1",
    "minimatch": "^9.0.0",
    "nanoid": "^4.0.2",
    "node-gyp": "^9.3.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "rimraf": "^5.0.0",
    "semver": "^7.4.0",
    "typescript": "^5.0.4",
    "vitest": "latest",
    "wrangler": "2.17.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "pnpm@8.3.1",
  "pnpm": {},
  "auto": {
    "plugins": [
      "npm",
      "pr-body-labels"
    ]
  }
}
